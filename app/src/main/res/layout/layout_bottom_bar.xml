<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="76dp"

    android:layout_gravity="bottom"

    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- BOTTOM BAR -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="76dp"

        android:layout_gravity="bottom"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:background="@drawable/bottom_bar_background"

        android:elevation="12dp"

        android:weightSum="5">


        <!-- HOME -->

        <LinearLayout

            android:id="@+id/navHomeLayout"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical"

            android:clickable="true"
            android:focusable="true"

            android:background="?attr/selectableItemBackground">

            <ImageView

                android:id="@+id/ivNavHome"

                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/hm_ic_home"

                android:contentDescription="Home"

                app:tint="#9299B2" />

            <TextView

                android:id="@+id/tvNavHome"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Home"

                android:textColor="#9299B2"
                android:textSize="10sp"

                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- RECORDS -->

        <LinearLayout

            android:id="@+id/navRecordsLayout"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical"

            android:clickable="true"
            android:focusable="true"

            android:background="?attr/selectableItemBackground">

            <ImageView

                android:id="@+id/ivNavRecords"

                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/hm_ic_records"

                android:contentDescription="Records"

                app:tint="#9299B2" />

            <TextView

                android:id="@+id/tvNavRecords"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Records"

                android:textColor="#9299B2"
                android:textSize="10sp"

                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- CENTER ADD BUTTON -->

        <FrameLayout

            android:id="@+id/navAddLayout"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"

            android:clipChildren="false"
            android:clipToPadding="false">


            <com.google.android.material.floatingactionbutton.FloatingActionButton

                android:id="@+id/fabAdd"

                android:layout_width="54dp"
                android:layout_height="54dp"

                android:layout_gravity="center"

                android:contentDescription="Add Health Record"

                android:backgroundTint="#5146B8"

                app:fabSize="normal"

                app:fabCustomSize="54dp"

                app:maxImageSize="25dp"

                app:elevation="8dp"

                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"

                app:srcCompat="@drawable/hm_ic_add"

                app:tint="#FFFFFF" />

        </FrameLayout>


        <!-- INSIGHTS -->

        <LinearLayout

            android:id="@+id/navStatsLayout"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical"

            android:clickable="true"
            android:focusable="true"

            android:background="?attr/selectableItemBackground">

            <ImageView

                android:id="@+id/ivNavStats"

                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/hm_ic_stats"

                android:contentDescription="Insights"

                app:tint="#9299B2" />

            <TextView

                android:id="@+id/tvNavStats"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Insights"

                android:textColor="#9299B2"
                android:textSize="10sp"

                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- SETTINGS -->

        <LinearLayout

            android:id="@+id/navSettingsLayout"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical"

            android:clickable="true"
            android:focusable="true"

            android:background="?attr/selectableItemBackground">

            <ImageView

                android:id="@+id/ivNavSettings"

                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_settings"

                android:contentDescription="Settings"

                app:tint="#9299B2" />

            <TextView

                android:id="@+id/tvNavSettings"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Settings"

                android:textColor="#9299B2"

                android:textSize="10sp"

                android:layout_marginTop="5dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>